# Copy to .env and fill in. Placeholders only - never commit real credentials.
APP_ENV=local
# DATABASE_URL defaults to SQLite at backend/data/beeproof.db
# DATABASE_URL=postgresql+psycopg://beeproof:beeproof@localhost:5432/beeproof
STORE=local
# STORE=gcs requires BUCKET
BUCKET=
PROJECT=
CORS_ORIGINS=*

# Witness B. heuristic = offline text-layer parser (digital PDFs only); gemini = Vertex AI vision
EXTRACTOR=heuristic
GEMINI_MODEL=
GEMINI_LOCATION=us-central1

# Witness A. auto = PyMuPDF words for digital pages, Document AI for scans when configured
LAYOUT_PROVIDER=auto
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=

# Pipeline policy
TAU=0.80
PAGE_CONCURRENCY=8
MAX_REPAIR_ATTEMPTS=2
MAX_REPAIR_CALLS_PER_JOB=60
MAX_JOB_ATTEMPTS=3
FLAG_WITNESS_A=true
FLAG_VALIDATORS=true
FLAG_RELOOK=true
FLAG_MEMORY=true

# Limits
MAX_UPLOAD_BYTES=20971520
MAX_DOCUMENT_PAGES=30
MAX_IMAGE_PIXELS=40000000

# Queue: redis://host:6379/0 wakes workers instantly (compose sets this); empty = workers poll the database
QUEUE_URL=

# Worker: inline runs inside the API process; off = run `python -m beeproof.worker` separately
WORKER_MODE=inline
WORKER_POLL_SECONDS=1
STALE_JOB_SECONDS=900

# Optional cost estimates (USD per page). 0 = unknown; costs are then reported as null.
GEMINI_USD_PER_PAGE=0
DOCAI_USD_PER_PAGE=0
LOG_LEVEL=INFO
